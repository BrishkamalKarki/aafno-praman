# ===========================================================================
# Aafno Praman backend configuration
#
#   cp .env.example .env    then fill in the three REQUIRED values below.
#
# None of the three has a default in settings. That is deliberate: booting with
# a predictable SECRET_KEY or KEY_ENCRYPTION_KEY would make every issuer's
# signing key recoverable, and a predictable NATIONAL_ID_PEPPER would turn the
# citizenship lookup column into a searchable citizen list. A silent insecure
# default is worse than a loud startup failure.
# ===========================================================================

# --- REQUIRED --------------------------------------------------------------

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts custodial issuer private keys AND citizenship numbers at rest. If this
# is lost, every issuer key becomes undecryptable and each organisation must be
# re-approved.
KEY_ENCRYPTION_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Secret mixed into every citizenship-number lookup hash.
#
# A Nepali citizenship number is district-structured and sequentially issued, so
# the whole plausible keyspace can be walked exhaustively — a plain SHA-256 of
# one is reversible in seconds. HMAC under a secret the database does not contain
# is what keeps the lookup column from being a searchable citizen list.
#
# Rotating this invalidates every stored hash. SeekerProfile.hmac_version exists
# so a rotation can be migrated incrementally rather than all at once.
NATIONAL_ID_PEPPER=

# --- Django ----------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Postgres (docker compose default):
DATABASE_URL=postgres://veridock:veridock@localhost:5432/veridock
# Zero-dependency local alternative — uncomment to run with no Postgres at all:
# DATABASE_URL=sqlite:///db.sqlite3

# --- Frontend / CORS -------------------------------------------------------

PUBLIC_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Blockchain ------------------------------------------------------------
#
# Target network: Sepolia, Ethereum's public test network. Credential
# fingerprints are anchored there as real transactions, so a verifier can check
# any of them on sepolia.etherscan.io without trusting this API at all.
#
# To run everything locally instead — no faucet, no funded key, instant blocks —
# swap the three CHAIN_ values below for the commented Hardhat block. Nothing
# else changes; the chain is addressed entirely through these variables.
#
#   CHAIN_RPC_URL=http://127.0.0.1:8545
#   CHAIN_ID=31337
#   CHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

CHAIN_ENABLED=True

# Public endpoint, no API key. Rate-limited: use a dedicated Infura/Alchemy URL
# for anything beyond a demo, because a throttled RPC surfaces as credentials
# stuck in PENDING_ANCHOR rather than as an obvious network error.
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Printed by `npm run deploy:sepolia` in contracts/ (or deploy:local for Hardhat).
CHAIN_CONTRACT_ADDRESS=

# The platform registrar's key — the account that approves issuers on chain and
# tops up their gas. On Sepolia this MUST be an account you generated and funded
# from a faucet yourself.
#
# The value below is Hardhat's well-known account #0. It is public, every
# attacker has it, and it is here only so the local Hardhat path works out of
# the box. Anchoring to Sepolia with it means anyone can drain the account and
# approve organisations in your registry's name.
CHAIN_REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia blocks are ~12s and fees move, unlike a local node where every
# transaction is mined instantly at a price nobody pays. Raise this to 180 if
# anchoring times out; a timeout leaves the record in PENDING_ANCHOR, which
# `manage.py anchor_pending` picks up, so it is recoverable rather than lost.
CHAIN_TX_TIMEOUT_SECONDS=120
CHAIN_GAS_MULTIPLIER=1.2

# Gas handed to each issuer's custodial address, so a university registrar never
# has to acquire testnet ETH to publish a degree.
#
# Sized for Sepolia faucets, which hand out fractions of an ETH per day. The
# defaults in settings are 0.1/0.01 ETH — fine against a Hardhat node with
# 10,000 pre-funded ETH, and enough to exhaust a real faucet balance on the
# third organisation approved. An anchor costs roughly 0.0003 ETH, so 0.005
# covers about fifteen issuances before a top-up.
CHAIN_GAS_TOPUP_WEI=5000000000000000
CHAIN_GAS_MIN_BALANCE_WEI=1000000000000000

# --- Credential confirmation ------------------------------------------------
# How long the "is this you?" link in a credential email stays valid, in hours.
# One week: long enough for a graduate who checks email weekly, short enough
# that an old institutional mail archive is not a standing takeover risk.
CREDENTIAL_CONFIRM_TTL_HOURS=168

# --- Cache -----------------------------------------------------------------
# Backs every DRF rate limit. LocMemCache is per-process, so it is fine for a
# single local dev server and unsafe anywhere with more than one worker — the
# production settings module refuses to boot with it. Use redis://… there.
CACHE_URL=locmemcache://aafnopraman

# --- Plans and limits ------------------------------------------------------

FREE_PLAN_MONTHLY_LOOKUPS=50
VERIFY_ANON_THROTTLE=60/hour
