# Base URL of the Django API. Server- and client-visible: the browser talks to
# it directly, so it cannot be a server-only secret.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# --- Chain -----------------------------------------------------------------
#
# The network staff wallets must be on before the issuer and employer consoles
# open. 11155111 is Sepolia; 31337 is a local Hardhat node.
#
# This MUST match CHAIN_ID in backend/.env. If it does not, the console asks
# people to switch to a network the backend is not anchoring to, and they end up
# on an explorer page with no transaction on it.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Where a transaction hash links to. Leave blank for a local Hardhat node — it
# has no explorer, and a link to nothing is worse than plain text.
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
